+    def _strip_inline_media(self, segments: Any) -> int:
+        """递归去掉消息段（含转发节点）中的内嵌媒体字节，保留 hash 与占位描述。"""
+        stripped = 0
+        for segment in segments if isinstance(segments, list) else []:
+            if not isinstance(segment, dict):
+                continue
+            if segment.pop("binary_data_base64", None):
+                stripped += 1
+                # 语音没有可回读的图片库，去掉字节后改为占位文本；图片保留 hash 与序号。
+                if segment.get("type") == "voice":
+                    segment.clear()
+                    segment.update(self._build_text_segment("[voice]"))
+                else:
+                    segment["data"] = segment.get("data") or OVER_BUDGET_DESCRIPTION
+            if segment.get("type") == "forward" and isinstance(segment.get("data"), list):
+                for node in segment["data"]:
+                    if isinstance(node, dict):
+                        stripped += self._strip_inline_media(node.get("content"))
+        return stripped
+
+    @staticmethod
+    def _take_inline_budget(size: int) -> bool:
+        """从当前消息的媒体预算中扣除；预算不足返回 False。未处于消息构造流程时不限制。"""
+        budget = _inline_budget.get()
+        if budget is None:
+            return True
+        if size > budget["remaining"]:
+            budget["skipped"] += 1
+            return False
+        budget["remaining"] -= size
+        return True
 
