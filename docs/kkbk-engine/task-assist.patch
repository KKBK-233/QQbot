+    @HookHandler('kkbk.before_request', name='kkbk_current_task', timeout_ms=6000)
+    async def kkbk_before(self, **kwargs):
+        """新引擎使用真实触发编号绑定当前图片，不再扫描旧规划器输出。"""
+        session = str(kwargs.get('session_id') or '')
+        message_id = str(kwargs.get('trigger_message_id') or '')
+        if not session or not message_id or not kwargs.get('requires_reply'):
+            return {'action': 'continue'}
+        message = await self.ctx.message.get_by_id(message_id, chat_id=session)
+        if not message or message.get('session_id') != session:
+            return {'action': 'continue'}
+        body = ' '.join(str(p.get('data', '')) for p in message.get('raw_message', []) if p.get('type') == 'text')
+        task = PendingTask(message_id, body, time.time(),
+                           bool(IMAGE_WORDS.search(body)) and not bool(IMAGE_EDIT_WORDS.search(body)),
+                           is_task=bool(TASK_WORDS.search(body)))
+        self.flow.pending[session] = task
+        await bind_visual_target(self.ctx, session, task, message, bool(IMAGE_EDIT_WORDS.search(body)))
+        data = {'task_message_id': message_id, 'request': body,
+                'image_source_message_ids': getattr(task, 'image_source_message_ids', [])}
+        hint = ('本轮图片来源已经按用户消息绑定。需要识图时调用analyze_task_image，'
